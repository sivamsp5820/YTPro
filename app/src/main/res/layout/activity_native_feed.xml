<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">


    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- YouTube Logo -->
        <ImageView
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_youtube_logo"
            android:contentDescription="YouTube Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="YouTube"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Header Actions: Notification Bell & Search -->
        <ImageView
            android:id="@+id/btn_bell"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="18dp"
            android:src="@drawable/ic_bell_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications" />

        <ImageView
            android:id="@+id/btn_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search" />

    </LinearLayout>

    <!-- Category Chips Bar -->
    <HorizontalScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/header_layout"
        android:background="#000000"
        android:scrollbars="none"
        android:paddingHorizontal="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="All"
                android:textColor="#000000"
                app:chipBackgroundColor="#FFFFFF"
                app:chipCornerRadius="16dp"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Gaming"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#272727"
                app:chipCornerRadius="16dp" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Music"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#272727"
                app:chipCornerRadius="16dp" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Live"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#272727"
                app:chipCornerRadius="16dp" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Podcasts"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#272727"
                app:chipCornerRadius="16dp" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Tech"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#272727"
                app:chipCornerRadius="16dp" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Main Content Video List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/category_scroll"
        android:layout_above="@id/bottom_navigation">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Official YouTube Style Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
